# ==============================================================================
# LILIANA SALON — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# IMPORTANTE: Nunca coloques secretos reales en este archivo ni lo subas a Git.
# Copia este archivo a `.env.local` para desarrollo local y configura estas
# variables en el panel de Vercel para producción.
# ==============================================================================

# --- Firebase Client SDK (Públicas para el navegador) ---
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="liliana-salon.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="liliana-salon"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="liliana-salon.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="570754067993"
NEXT_PUBLIC_FIREBASE_APP_ID="1:570754067993:web:d376ea3cb0346da177c488"

# --- Firebase App Check (Opcional pero recomendado para producción) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Token de depuración para desarrollo local con App Check (opcional)
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN="true"

# --- Firebase Admin SDK (Privadas para el Servidor / Next.js API Routes / Scripts) ---
# NUNCA uses prefijo NEXT_PUBLIC_ en estas variables.
FIREBASE_PROJECT_ID="liliana-salon"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@liliana-salon.iam.gserviceaccount.com"
# La clave privada puede incluir saltos de línea \n escapados o entre comillas
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
